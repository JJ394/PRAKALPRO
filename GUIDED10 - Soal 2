def rata2_kelas(filename):
    handle = open(filename)
    count = 0
    barisKe = 0
    total = 0
    for i in handle:
        barisKe += 1
        if barisKe >= 4:
            data = i.strip().split(",")
            nilai = float(data[-1])
            total += nilai
            count += 1
    print("Nilai rata2 " + str(total/count))
    
rata2_kelas('file3.txt')
            
